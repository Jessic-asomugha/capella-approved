# Send every page URL (/services, /about, /contact, /quote) to index.html so the
# React app can handle it. Real files (images, sitemap.xml) are served as-is.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
